{% import "_includes/forms" as forms %}
{% set drafts = craft.entries.draftOf(entry.id).siteId(entry.site.id).status(null).all %}
{% set canPublishDraft = currentUser.can('saveEntries'~permissionSuffix) %}
{% set isVersion = className(entry) == 'craft\\models\\EntryVersion' %}
{% set paneKey = random() %}

<style>
	.publisher-x-actions {
		display: flex;
		justify-content: flex-end;
		padding-top: 14px;
		margin-left: -24px;
		margin-right: -24px;
		padding-right: 14px;
		border-top: 1px solid rgba(51, 64, 77, 0.1);
	}

	.publisher-x-heading {
		display: flex;
		justify-content: flex-start;
		padding: 14px;
		margin: -14px -14px 0px -24px !important;
	}

    .pending-publisher-x-schedule {
		margin: 0px 0px 14px 0px;
	}

    .pending-publisher-x {
		display: flex;
        flex-direction: column;
		align-items: flex-start;
        padding: 14px 0px 14px 0px;
        margin-left: -10px;
	}

	.publisher-x-schedule {
		padding-top: 14px;
		padding-bottom: 14px;
	}
</style>

<div class="meta" data-publisher-x-pending="{{ paneKey }}">
	{% include 'publisher-x/_cp/pendingEntries' %}
</div>

{# The inputs have no name, so the entry editor neither saves nor autosaves them with the entry. #}
{% if drafts|length > 0 and canPublishDraft %}
	<div class="meta publisher-x-schedule" data-publisher-x-form="{{ paneKey }}" data-site-id="{{ entry.site.id }}" data-locale="{{ craft.app.formattingLocale.id }}" data-timezone="{{ craft.app.timeZone }}">
		<div class="publisher-x-heading">
			<h4>{{ 'Schedule a publish date'|t('publisher-x') }}</h4>
		</div>
		<div class="field">
			<div class="heading">
				<label for="publisherDraftId{{ paneKey }}">{{ 'Draft'|t('publisher-x') }}</label>
			</div>
			<div class="input">
				<div class="select">
					<select id="publisherDraftId{{ paneKey }}" data-publisher-x-draft>
						{% for draft in drafts %}
							<option value="{{ draft.draftId }}">{{ draft.draftName }}</option>
						{% endfor %}
					</select>
				</div>
			</div>
		</div>

		{{ forms.dateTimeField({
            label: "Publish date"|t('publisher-x'),
            id: 'publisherPublishAt' ~ paneKey,
            value: now,
            errors: publisherEntry is defined ? publisherEntry.getError('publishAt') : null,
            disabled: isVersion
        }) }}

		<div class="publisher-x-actions">
			<div>
				<button type="button" class="btn" data-publisher-x-add>{{ 'Add publish date'|t('publisher-x') }}</button>
			</div>
		</div>
	</div>

	{% js %}
		(function() {
			var form = document.querySelector('[data-publisher-x-form="{{ paneKey }}"]');
			var pending = document.querySelector('[data-publisher-x-pending="{{ paneKey }}"]');
			if (!form || !pending) {
				return;
			}
			var button = form.querySelector('[data-publisher-x-add]');
			var value = function(selector) {
				var input = form.querySelector(selector);
				return input ? input.value : '';
			};
			button.addEventListener('click', function() {
				if (button.classList.contains('loading')) {
					return;
				}
				button.classList.add('loading');
				Craft.sendActionRequest('POST', 'publisher-x/entries/save', {
					data: {
						publisher_draftId: value('[data-publisher-x-draft]'),
						publisher_sourceSiteId: form.dataset.siteId,
						publisher_publishAt: {
							date: value('input[id$="-date"]'),
							time: value('input[id$="-time"]'),
							locale: form.dataset.locale,
							timezone: form.dataset.timezone,
						},
					},
				}).then(function(response) {
					pending.innerHTML = response.data.html;
					Craft.initUiElements(pending);
					Craft.cp.displaySuccess(response.data.message);
				}).catch(function(error) {
					var data = error && error.response && error.response.data;
					Craft.cp.displayError(data && (data.message || data.error) || Craft.t('app', 'A server error occurred.'));
				}).finally(function() {
					button.classList.remove('loading');
				});
			});
		})();
	{% endjs %}
{% endif %}
